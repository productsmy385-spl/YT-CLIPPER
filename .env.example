# ==========================================
# GTA 6 SHORTS AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Port (Railway / Cloud deployment automatically sets this)
PORT=8080

# --- GOOGLE OAUTH 2.0 & YOUTUBE DATA API V3 ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public OAuth callback redirect URI (Must match Authorized redirect URIs in Google Cloud Console)
# For local dev: http://localhost:3000/api/youtube/callback
# For Railway production: https://yt-clipper-production-7464878a.up.railway.app/api/youtube/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Optional YouTube Data API Key for public data lookups
YOUTUBE_API_KEY=

# Secret key for encrypting OAuth refresh and access tokens at rest (AES-256-GCM)
# Generate any random 32-character string, e.g. using: openssl rand -hex 16
TOKEN_ENCRYPTION_KEY=gta6_shorts_ai_production_oauth_encryption_key_2026

# --- PUBLISHING WORKER DEEMON ---
# Default timezone for scheduled publishing
DEFAULT_TIMEZONE=Asia/Kolkata
# Scheduled publishing worker scan interval in seconds (default: 30)
SCHEDULER_INTERVAL_SECONDS=30
