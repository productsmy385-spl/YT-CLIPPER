# ==========================================
# GTA 6 SHORTS AI - ENVIRONMENT CONFIGURATION
# Set these as Railway service variables. Never commit real values.
# ==========================================

# --- ACCESS ---
# Required for any public deployment: every page/API asks for this password (HTTP Basic auth, any username).
APP_PASSWORD=

# --- DATABASE (durable copy) ---
# Railway: ${{Postgres.DATABASE_URL}}. Without it, data lives only in the container and is lost on redeploy.
DATABASE_URL=
# Optional: public proxy URL, used automatically when running outside Railway against a *.railway.internal URL.
DATABASE_PUBLIC_URL=

# --- STORAGE ---
# Media (uploads, sources, rendered shorts) is written under /app/storage. Attach a Railway volume there.
# STORAGE_DIR=/app/storage
# MAX_UPLOAD_BYTES=8589934592

# --- AI (video + audio analysis, highlight ranking) ---
GEMINI_API_KEY=
# Optional pin; defaults to gemini-flash-latest.
# GEMINI_MODEL=
# Used when the main model is overloaded (default gemini-flash-lite-latest).
# GEMINI_FALLBACK_MODEL=

# --- YOUTUBE (OAuth for channel connection, upload, and fetching your own videos) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
# Must be listed in Google Cloud Console > Credentials > Authorized redirect URIs
GOOGLE_REDIRECT_URI=https://YOUR-APP.up.railway.app/api/youtube/callback
YOUTUBE_API_KEY=
# REQUIRED and must never change between deploys (changing it makes stored tokens unreadable).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Which YouTube videos may be fetched: all (any public/unlisted, default) | owned (connected channel only) | off
# YOUTUBE_ACQUISITION=all
# Delete abandoned uploads after this many hours (default 168)
# UPLOAD_RETENTION_HOURS=168
# TIKTOK_ACCESS_TOKEN=

# --- PC <-> PRODUCTION (fetch helper + "Send to production") ---
# YouTube blocks downloads from datacenter IPs (Railway). Set the SAME random secret on Railway and on your PC
# (24+ characters; generate with: openssl rand -hex 32). Without it these features are off.
# SYNC_TOKEN=
# Railway: where YouTube videos are downloaded. helper = always by the PC fetch helper (recommended on Railway),
# auto = try the server first and fall back to the helper when YouTube blocks it (default), server = server only.
# YOUTUBE_FETCH_VIA=helper
# PC only: the production site that "npm run fetch-helper" and "Send to production" talk to.
# PRODUCTION_URL=https://YOUR-APP.up.railway.app
# PC only: keep local runs off the production database even though DATABASE_URL is set above.
# POSTGRES_DISABLED=true

# --- WORKER / RENDERING ---
# WORKER_CONCURRENCY=1
# RENDER_PRESET=veryfast
# RENDER_CRF=20

# --- PUBLISHING ---
DEFAULT_TIMEZONE=Asia/Kolkata
SCHEDULER_INTERVAL_SECONDS=30

# Local tooling (defaults to binaries on PATH)
# FFMPEG=ffmpeg
# FFPROBE=ffprobe
# YTDLP_PATH=
